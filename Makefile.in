@SET_MAKE@

CC	= @CC@
LDCC	= @LDCC@
LDCC ?= $(CC)
CFLAGS	= @CFLAGS@
#CFLAGS	= @CFLAGS@ -DCANNOTUSEHIGHSPEED
LIBS	= @LIBS@
INSTALL	= @INSTALL@
INSTALL_PROGRAM	= @INSTALL_PROGRAM@
INSTALL_DATA	= @INSTALL_DATA@
bindir	= @bindir@
mandir  = @mandir@

SRCS1	= tty.c command.c command1.c getuint.c jpeg.c ppm.c bmp.c qvplay.c
OBJS1	= tty.o command.o command1.o getuint.o jpeg.o ppm.o bmp.o qvplay.o
PROG1	= qvplay
MAN1    = qvplay.1

SRCS3	= tty.c command.c command3.c qvalldel.c
OBJS3	= tty.o command.o command3.o qvalldel.o
PROG3	= qvalldel
MAN3    = qvalldel.1

.c.o:
	$(CC) $(CFLAGS) $(DEFS) -MMD -MP -c $<

all:	$(PROG1) $(PROG3)

$(PROG1): $(OBJS1)
	$(LDCC) -o $(PROG1) $(CFLAGS) $(OBJS1) $(LIBS)

$(PROG3): $(OBJS3)
	$(LDCC) -o $(PROG3) $(CFLAGS) $(OBJS3) $(LIBS)

clean:
	rm -f $(PROG1) $(OBJS1) $(PROG3) $(OBJS3) $(OBJS1:.o=.d) $(OBJS3:.o=.d)

realclean:
	rm -f $(PROG1) $(OBJS1) $(PROG3) $(OBJS3) $(OBJS1:.o=.d) $(OBJS3:.o=.d) config.log config.cache config.status Makefile

# at RedHat 5.2 environment /dev/cua1 tty device's owner is root and group is uucp
# some BSD environment /dev/tty is uucp/bin

install:	all
	$(INSTALL_PROGRAM) -s -o root -g uucp -m 2755 $(PROG1) $(bindir)/$(PROG1)
	$(INSTALL_PROGRAM) -s -o root -g uucp -m 2755 $(PROG3) $(bindir)/$(PROG3)
	$(INSTALL_PROGRAM) -o root -g bin -m 444 $(MAN1) $(mandir)/$(MAN1)
	$(INSTALL_PROGRAM) -o root -g bin -m 444 $(MAN3) $(mandir)/$(MAN3)

-include $(OBJS1:.o=.d) $(OBJS3:.o=.d)

.PHONY: all clean install realclean
